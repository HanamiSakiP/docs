#!/usr/bin/env bash
# rustmgr - Rust 工具链管理器
# 支持 rustup / cargo 的安装、备份、恢复
#
# 安装: cp rustmgr ~/.local/bin/rustmgr && chmod +x ~/.local/bin/rustmgr
# 或:   ln -sf "$(pwd)/rustmgr" ~/.local/bin/rustmgr

set -euo pipefail
IFS=$'\n\t'

VERSION="1.0.0"
PROG_NAME="${0##*/}"

# ================================================================
# 路径解析（支持软链接调用）
# ================================================================
resolve_script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [ -L "$src" ]; do
        dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[ -n "$SELF_PATH" ] || SELF_PATH="$SCRIPT_DIR/$PROG_NAME"

BACKUP_DIR="${RUSTMGR_BACKUP_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/rustmgr/backups}"

# ================================================================
# Rust 路径
# ================================================================
RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"

RUSTUP_INIT_URL="${RUSTUP_INIT_URL:-https://sh.rustup.rs}"

# ================================================================
# 颜色 & 日志
# ================================================================
if [ -t 1 ]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; DIM=''; NC=''
fi

log_info()  { printf '%s[INFO]%s %s\n' "$CYAN"  "$NC" "$*"; }
log_ok()    { printf '%s[ OK ]%s %s\n' "$GREEN" "$NC" "$*"; }
log_warn()  { printf '%s[WARN]%s %s\n' "$YELLOW" "$NC" "$*" >&2; }
log_error() { printf '%s[ERR ]%s %s\n' "$RED"   "$NC" "$*" >&2; }

substep() { printf '      %s→%s %s\n' "$DIM" "$NC" "$*"; }

# ================================================================
# tar 能力检测
# ================================================================
TAR_WARN_OPTS=()
if tar --warning=no-file-changed -cf /dev/null /dev/null >/dev/null 2>&1; then
    TAR_WARN_OPTS=(--warning=no-file-changed)
else
    log_warn "当前 tar 不支持 --warning=no-file-changed（将容忍 rc=1）"
fi

TAR_EXTRA_OPTS=()
if tar --ignore-failed-read -cf /dev/null /dev/null >/dev/null 2>&1; then
    TAR_EXTRA_OPTS=(--ignore-failed-read)
else
    log_warn "当前 tar 不支持 --ignore-failed-read（ELOOP 等读错误会中断）"
fi

# ================================================================
# 排除模式
# ================================================================
EXCLUDES=(
    '--exclude=.git' '--exclude=.github' '--exclude=.gitignore'
    '--exclude=.cache'
    '--exclude=tmp' '--exclude=temp'
    '--exclude=*.log'
)

CARGO_CACHE_EXCLUDES=(
    '--exclude=registry'
    '--exclude=git'
)

# ================================================================
# 工具状态检测
# ================================================================
is_rust_installed() {
    [ -x "$CARGO_HOME/bin/rustup" ] && return 0
    [ -x "$CARGO_HOME/bin/cargo" ] && return 0
    command -v rustup >/dev/null 2>&1 && return 0
    command -v cargo >/dev/null 2>&1
}

rust_version() {
    if [ -x "$CARGO_HOME/bin/rustc" ]; then
        "$CARGO_HOME/bin/rustc" --version 2>/dev/null | head -n1
    elif command -v rustc >/dev/null 2>&1; then
        rustc --version 2>/dev/null | head -n1
    fi
}

cargo_version() {
    if [ -x "$CARGO_HOME/bin/cargo" ]; then
        "$CARGO_HOME/bin/cargo" --version 2>/dev/null | head -n1
    elif command -v cargo >/dev/null 2>&1; then
        cargo --version 2>/dev/null | head -n1
    fi
}

rustup_version() {
    if [ -x "$CARGO_HOME/bin/rustup" ]; then
        "$CARGO_HOME/bin/rustup" --version 2>/dev/null | head -n1
    elif command -v rustup >/dev/null 2>&1; then
        rustup --version 2>/dev/null | head -n1
    fi
}

# ================================================================
# 依赖 & 磁盘检查
# ================================================================
check_dependencies() {
    local dep
    for dep in curl tar; do
        command -v "$dep" >/dev/null 2>&1 || { log_error "缺少必需依赖: $dep"; exit 1; }
    done
    [ -w "$HOME" ] || { log_error "用户目录 '$HOME' 不可写"; exit 1; }
}

check_disk() {
    local avail_kb
    avail_kb=$(df -Pk "$BACKUP_DIR" 2>/dev/null | awk 'NR==2 {print $4}' || true)
    if [ -n "${avail_kb:-}" ] && [ "$avail_kb" -lt 204800 ]; then
        log_warn "备份目录剩余空间较小（${avail_kb}KB），备份可能失败"
    fi
}

# ================================================================
# 配置文件辅助
# ================================================================
add_line_if_missing() {
    local file="$1" line="$2"
    touch "$file"
    if ! grep -Fqx -- "$line" "$file"; then
        printf '%s\n' "$line" >> "$file"
        substep "写入 $file: $line"
    fi
}

# ================================================================
# 下载辅助
# ================================================================
download_file() {
    local url="$1" out="$2"
    substep "下载: $url"
    local -a curl_opts=( -fL --retry 3 --retry-delay 2 --connect-timeout 15 )
    if [ -t 2 ]; then
        curl_opts+=( --progress-bar )
    else
        curl_opts+=( -sS )
    fi
    curl "${curl_opts[@]}" "$url" -o "$out"
}

# ================================================================
# 进度执行
# ================================================================
_run_progress() {
    local desc="$1" logfile="$2"; shift 2
    local chars=('/' '-' '\' '|') i=0 pid rc=0
    "$@" >"$logfile" 2>&1 &
    pid=$!
    if [ -t 1 ]; then
        while kill -0 "$pid" 2>/dev/null; do
            printf '\r  %s[%s]%s %s  ' "$BLUE" "${chars[i++%4]}" "$NC" "$desc"
            sleep 0.15
        done
    fi
    wait "$pid" || rc=$?
    if [ -t 1 ]; then
        if [ "$rc" -eq 0 ]; then
            printf '\r  %s[✓]%s %-50s\n' "$GREEN" "$NC" "$desc"
        else
            printf '\r  %s[✗]%s %-50s\n' "$RED" "$NC" "$desc"
        fi
    fi
    if [ "$rc" -ne 0 ]; then
        log_warn "命令输出（末尾）:"
        sed 's/^/      | /' "$logfile" | tail -n 30 >&2
    fi
    return "$rc"
}

# ================================================================
# 在线安装
# ================================================================
install_rust_online() {
    local no_modify_path="${1:-0}"
    local install_script

    install_script="$(mktemp)"
    substep "获取 rustup 安装脚本"
    if ! download_file "$RUSTUP_INIT_URL" "$install_script"; then
        rm -f "$install_script"
        log_error "下载 rustup 安装脚本失败"
        return 1
    fi

    local -a init_args=(-y --default-toolchain stable)
    [ "$no_modify_path" -eq 1 ] && init_args+=(--no-modify-path)

    local logfile rc=0
    logfile="$(mktemp)"
    _run_progress "执行 rustup 安装脚本" "$logfile" \
        env "RUSTUP_HOME=$RUSTUP_HOME" "CARGO_HOME=$CARGO_HOME" \
        sh "$install_script" "${init_args[@]}" || rc=$?

    rm -f "$install_script" "$logfile"

    if [ "$rc" -ne 0 ]; then
        log_error "rustup 安装失败"
        return 1
    fi

    # ---- 环境变量写入 ----
    local cfg_files=("$HOME/.bashrc" "$HOME/.profile" "$HOME/.zshrc")
    local f
    for f in "${cfg_files[@]}"; do
        [ -f "$f" ] || continue
        if [ "$RUSTUP_HOME" != "$HOME/.rustup" ]; then
            add_line_if_missing "$f" "export RUSTUP_HOME=\"$RUSTUP_HOME\""
        fi
        if [ "$CARGO_HOME" != "$HOME/.cargo" ]; then
            add_line_if_missing "$f" "export CARGO_HOME=\"$CARGO_HOME\""
        fi
        if [ "$no_modify_path" -eq 1 ]; then
            add_line_if_missing "$f" '. "$HOME/.cargo/env"'
        fi
    done

    export RUSTUP_HOME CARGO_HOME
    [ -f "$CARGO_HOME/env" ] && . "$CARGO_HOME/env" 2>/dev/null || true
}

# ================================================================
# 备份
# ================================================================
backup_rust() {
    local out="$BACKUP_DIR/rust/rust_backup_$(date +%Y%m%d%H%M%S).tar.gz"
    local tmp pack_stage
    local found=0

    mkdir -p "$BACKUP_DIR/rust"
    tmp="$(mktemp -d)"
    pack_stage="$(mktemp -d)"
    trap 'rm -rf -- "$tmp" "$pack_stage"' EXIT

    check_disk

    # ---- ~/.rustup ----
    if [ -d "$RUSTUP_HOME" ]; then
        substep "打包 $RUSTUP_HOME"
        mkdir -p "$tmp/rustup"
        local tarfile crc=0 xrc=0
        tarfile="$(mktemp "$pack_stage/rustup.XXXXXX.tar")"
        ( cd "$RUSTUP_HOME" && tar \
            "${TAR_WARN_OPTS[@]+"${TAR_WARN_OPTS[@]}"}" \
            "${TAR_EXTRA_OPTS[@]+"${TAR_EXTRA_OPTS[@]}"}" \
            "${EXCLUDES[@]}" -cf "$tarfile" . ) || crc=$?
        if [ "$crc" -gt 1 ]; then
            rm -f -- "$tarfile"
            log_error "打包 $RUSTUP_HOME 失败 (rc=$crc)"
            return 1
        fi
        [ "$crc" -eq 1 ] && log_warn "打包 $RUSTUP_HOME 时有文件变化（已容忍）"
        ( cd "$tmp/rustup" && tar -xpf "$tarfile" ) || xrc=$?
        rm -f -- "$tarfile"
        if [ "$xrc" -ne 0 ]; then
            log_error "解压 $RUSTUP_HOME 失败"
            return 1
        fi
        found=1
    else
        substep "跳过 $RUSTUP_HOME（不存在）"
    fi

    # ---- ~/.cargo（排除缓存） ----
    if [ -d "$CARGO_HOME" ]; then
        substep "打包 $CARGO_HOME（排除 registry / git 缓存）"
        mkdir -p "$tmp/cargo"
        local tarfile crc=0 xrc=0
        tarfile="$(mktemp "$pack_stage/cargo.XXXXXX.tar")"
        ( cd "$CARGO_HOME" && tar \
            "${TAR_WARN_OPTS[@]+"${TAR_WARN_OPTS[@]}"}" \
            "${TAR_EXTRA_OPTS[@]+"${TAR_EXTRA_OPTS[@]}"}" \
            "${EXCLUDES[@]}" \
            "${CARGO_CACHE_EXCLUDES[@]}" \
            -cf "$tarfile" . ) || crc=$?
        if [ "$crc" -gt 1 ]; then
            rm -f -- "$tarfile"
            log_error "打包 $CARGO_HOME 失败 (rc=$crc)"
            return 1
        fi
        [ "$crc" -eq 1 ] && log_warn "打包 $CARGO_HOME 时有文件变化（已容忍）"
        ( cd "$tmp/cargo" && tar -xpf "$tarfile" ) || xrc=$?
        rm -f -- "$tarfile"
        if [ "$xrc" -ne 0 ]; then
            log_error "解压 $CARGO_HOME 失败"
            return 1
        fi
        found=1
    else
        substep "跳过 $CARGO_HOME（不存在）"
    fi

    if [ "$found" -eq 0 ]; then
        log_error "未找到 Rust 相关目录（$RUSTUP_HOME / $CARGO_HOME）"
        return 1
    fi

    # ---- 环境变量片段 ----
    grep -E "(RUSTUP_HOME|CARGO_HOME|\.cargo/env|\.cargo/bin)" \
        "$HOME"/.{bashrc,zshrc,profile} 2>/dev/null \
        > "$tmp/env_config" || true

    {
        echo "ARCH=$(uname -m)"
        echo "OS=$(uname -s)"
        echo "RUSTUP_HOME=$RUSTUP_HOME"
        echo "CARGO_HOME=$CARGO_HOME"
    } > "$tmp/platform_info"

    tar -czf "$out" -C "$tmp" .
    rm -rf -- "$tmp" "$pack_stage"
    trap - EXIT

    log_ok "已创建: $out"
}

# ================================================================
# 恢复
# ================================================================
check_backup_file() {
    local file="$1"
    [ -f "$file" ] || { log_error "备份文件不存在: $file"; return 1; }
    tar -tzf "$file" >/dev/null 2>&1 || { log_error "非有效 tar.gz: $file"; return 1; }
}

restore_rust() {
    local backup_file="$1"
    check_backup_file "$backup_file" || return 1

    local temp_dir
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "$temp_dir"; trap - RETURN' RETURN

    substep "解压备份"
    tar -xzf "$backup_file" -C "$temp_dir"

    if [ -f "$temp_dir/platform_info" ]; then
        substep "备份平台信息:"
        sed 's/^/         /' "$temp_dir/platform_info"
        substep "当前平台: ARCH=$(uname -m) OS=$(uname -s)"
    fi

    local restored=0

    if [ -d "$temp_dir/rustup" ] && [ "$(ls -A "$temp_dir/rustup" 2>/dev/null)" ]; then
        substep "恢复 $RUSTUP_HOME"
        mkdir -p "$RUSTUP_HOME"
        cp -a "$temp_dir/rustup"/. "$RUSTUP_HOME"/
        restored=1
    fi

    if [ -d "$temp_dir/cargo" ] && [ "$(ls -A "$temp_dir/cargo" 2>/dev/null)" ]; then
        substep "恢复 $CARGO_HOME"
        mkdir -p "$CARGO_HOME"
        cp -a "$temp_dir/cargo"/. "$CARGO_HOME"/
        restored=1
    fi

    if [ "$restored" -eq 0 ]; then
        log_error "备份中未找到可恢复的 Rust 数据"
        return 1
    fi

    local cfg_files=("$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile")
    local f
    for f in "${cfg_files[@]}"; do
        [ -f "$f" ] || continue
        if [ "$RUSTUP_HOME" != "$HOME/.rustup" ]; then
            add_line_if_missing "$f" "export RUSTUP_HOME=\"$RUSTUP_HOME\""
        fi
        if [ "$CARGO_HOME" != "$HOME/.cargo" ]; then
            add_line_if_missing "$f" "export CARGO_HOME=\"$CARGO_HOME\""
        fi
        add_line_if_missing "$f" '. "$HOME/.cargo/env"'
    done

    export RUSTUP_HOME CARGO_HOME
    [ -f "$CARGO_HOME/env" ] && . "$CARGO_HOME/env" 2>/dev/null || true
    export PATH="$CARGO_HOME/bin:$PATH"

    log_ok "Rust 恢复完成"
}

# ================================================================
# 备份查找
# ================================================================
_find_backup_files() {
    local -a dirs=("$BACKUP_DIR/rust" "$BACKUP_DIR")
    local d
    shopt -s nullglob
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        local files=("$d/rust_backup_"*.tar.gz)
        if [ ${#files[@]} -gt 0 ]; then
            printf '%s\n' "${files[@]}" | LC_ALL=C sort
            shopt -u nullglob
            return 0
        fi
    done
    shopt -u nullglob
    return 0
}

find_latest_backup() {
    local files
    files="$(_find_backup_files)"
    [ -z "$files" ] && return 0
    printf '%s\n' "$files" | tail -n1
}

count_backups() {
    local files
    files="$(_find_backup_files)"
    if [ -z "$files" ]; then
        echo 0
    else
        printf '%s\n' "$files" | wc -l | tr -d ' '
    fi
}

# ================================================================
# install 前尝试从本地备份恢复
# ================================================================
try_restore_rust() {
    local backup
    backup="$(find_latest_backup)"
    if [ -z "$backup" ]; then
        return 1
    fi
    substep "发现本地备份: $(basename "$backup")"
    if restore_rust "$backup"; then
        return 0
    fi
    log_warn "从备份恢复失败，将回退到在线安装"
    return 1
}

# ================================================================
# 环境刷新
# ================================================================
reload_shell_env() {
    substep "刷新 shell 环境"
    set +u; set +e
    # shellcheck disable=SC1090
    source "$HOME/.bashrc" >/dev/null 2>&1
    set -e; set -u

    export RUSTUP_HOME CARGO_HOME
    if [ -f "$CARGO_HOME/env" ]; then
        # shellcheck disable=SC1091
        . "$CARGO_HOME/env" 2>/dev/null || true
    fi
    export PATH="$CARGO_HOME/bin:$PATH"
    return 0
}

verify_rust() {
    if is_rust_installed || command -v cargo >/dev/null 2>&1; then
        log_ok "Rust 验证通过"
        return 0
    fi
    log_error "Rust 验证失败"
    return 1
}

print_final_hint() {
    echo
    echo "${DIM}提示: 脚本内的环境刷新仅作用于当前进程，请在你的终端执行:${NC}"
    echo "    source ~/.bashrc  ${DIM}# 或 exec bash / 重开终端${NC}"
}

# ================================================================
# 清理（--force 用）
# ================================================================
clean_rust() {
    rm -rf "$RUSTUP_HOME" 2>/dev/null || true
    rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git" 2>/dev/null || true
    # 保留 CARGO_HOME 下的 config.toml / bin
}

# ================================================================
# 子命令: install
# ================================================================
cmd_install() {
    local force=0 no_restore=0 no_modify_path=0
    local arg

    for arg in "$@"; do
        case "$arg" in
            --force|-f)       force=1 ;;
            --no-restore)     no_restore=1 ;;
            --no-modify-path) no_modify_path=1 ;;
            -h|--help)        show_help; exit 0 ;;
            *)
                log_error "未知参数: $arg"; return 1 ;;
        esac
    done

    printf '\n%s=== rustmgr install ===%s\n' "$BOLD" "$NC"
    [ "$force" = "1" ] && log_warn "启用 --force，将重新安装 Rust"

    check_dependencies

    if is_rust_installed && [ "$force" -ne 1 ]; then
        log_warn "Rust 已安装，跳过"
        log_warn "如需强制重装，请加 --force"
        return 0
    fi

    if [ "$force" -eq 1 ] && is_rust_installed; then
        substep "清理已有的 Rust 工具链"
        clean_rust
    fi

    local restored=0
    if [ "$no_restore" -ne 1 ]; then
        if try_restore_rust; then
            restored=1
        fi
    else
        substep "已禁用本地恢复 (--no-restore)"
    fi

    if [ "$restored" -eq 0 ]; then
        substep "在线安装 Rust"
        install_rust_online "$no_modify_path" || return 1
    fi

    reload_shell_env
    verify_rust || return 1

    printf '\n'
    log_ok "=== Rust 安装完成 ==="
    print_final_hint
}

# ================================================================
# 子命令: backup
# ================================================================
cmd_backup() {
    printf '\n%s=== rustmgr backup ===%s\n' "$BOLD" "$NC"
    log_info "备份目录: $BACKUP_DIR"
    mkdir -p "$BACKUP_DIR"

    backup_rust
}

# ================================================================
# 子命令: restore
# ================================================================
cmd_restore() {
    local force=0
    local arg

    for arg in "$@"; do
        case "$arg" in
            --force|-f) force=1 ;;
            -h|--help)  show_help; exit 0 ;;
            *)
                log_error "未知参数: $arg"; return 1 ;;
        esac
    done

    printf '\n%s=== rustmgr restore ===%s\n' "$BOLD" "$NC"

    if is_rust_installed && [ "$force" -ne 1 ]; then
        log_warn "Rust 已安装，跳过（如需覆盖恢复请加 --force）"
        return 0
    fi

    local backup
    backup="$(find_latest_backup)"
    if [ -z "$backup" ]; then
        log_error "未找到 Rust 备份"
        return 1
    fi
    substep "使用备份: $(basename "$backup")"

    restore_rust "$backup" || return 1
    reload_shell_env
    verify_rust || return 1

    print_final_hint
    return 0
}

# ================================================================
# 子命令: status
# ================================================================
cmd_status() {
    printf '\n%s=== rustmgr status ===%s\n\n' "$BOLD" "$NC"
    printf '%-10s %-14s %-40s %s\n' "ITEM" "STATUS" "LOCATION" "VERSION"
    printf '%s\n' "--------------------------------------------------------------------------"

    local status rust_v cargo_v rustup_v bcnt

    if is_rust_installed; then
        status="${GREEN}installed${NC}"
        rust_v="$(rust_version 2>/dev/null || echo '-')"
        cargo_v="$(cargo_version 2>/dev/null || echo '-')"
        rustup_v="$(rustup_version 2>/dev/null || echo '-')"
    else
        status="${YELLOW}missing${NC}"
        rust_v="-" cargo_v="-" rustup_v="-"
    fi

    bcnt="$(count_backups)"

    printf '%-10s %-22b %-40s %s\n' "rust" "$status" "$CARGO_HOME" "$rust_v"
    printf '%-10s %-22s %-40s %s\n' "" "" "" "$cargo_v"
    printf '%-10s %-22s %-40s %s\n' "" "" "" "$rustup_v"
    printf '%-10s %-22b %-40s %s\n' "rustup" "$status" "$RUSTUP_HOME" "-"
    printf '         %sbackups: %s%s\n' "$DIM" "$bcnt" "$NC"

    printf '\n备份目录: %s\n' "$BACKUP_DIR"
    return 0
}

# ================================================================
# 子命令: list
# ================================================================
cmd_list() {
    printf '\n%s=== rustmgr list ===%s\n' "$BOLD" "$NC"

    local files
    files="$(_find_backup_files)"
    if [ -z "$files" ]; then
        printf '\n  %s(无备份)%s\n' "$DIM" "$NC"
        return 0
    fi

    printf '\n%s[Rust]%s\n' "$BOLD" "$NC"
    local f sz
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        sz="$(du -h "$f" 2>/dev/null | cut -f1)"
        printf '  %s  %s(%s)%s\n' "$(basename "$f")" "$DIM" "$sz" "$NC"
    done <<<"$files"
}

# ================================================================
# 子命令: self-install
# ================================================================
cmd_self_install() {
    local target_dir="${RUSTMGR_BIN_DIR:-$HOME/.local/bin}"
    local target="$target_dir/$PROG_NAME"
    local self="$SELF_PATH"

    printf '\n%s=== rustmgr self-install ===%s\n' "$BOLD" "$NC"
    log_info "源文件: $self"
    log_info "目标:   $target"

    [ -f "$self" ] || { log_error "找不到脚本源文件"; return 1; }

    if [ -e "$target" ] && cmp -s "$self" "$target"; then
        log_ok "已安装且内容一致，无需更新"
    else
        [ -e "$target" ] && log_warn "检测到旧版本，覆盖安装"
        mkdir -p "$target_dir" || { log_error "创建目录失败: $target_dir"; return 1; }
        cp -f "$self" "$target" || { log_error "复制失败: $target"; return 1; }
        chmod +x "$target" || { log_error "设置执行权限失败"; return 1; }
        log_ok "已安装: $target"
    fi

    case ":$PATH:" in
        *":$target_dir:"*) log_ok "$target_dir 已在 PATH 中" ;;
        *) log_warn "$target_dir 不在 PATH 中，请添加:"; echo "  export PATH=\"$target_dir:\$PATH\"" ;;
    esac

    substep "验证: $PROG_NAME --version"
    "$target" --version 2>/dev/null || true
    log_ok "完成。现在可以直接使用: $PROG_NAME status"
}

# ================================================================
# 帮助
# ================================================================
show_help() {
    cat <<EOF
${BOLD}rustmgr${NC} v${VERSION} - Rust 工具链管理器
${DIM}(rustup / cargo)${NC}

用法: ${BOLD}$PROG_NAME${NC} <command> [options]

命令:
  ${BOLD}install${NC}   安装 Rust（前置检查已安装；优先本地备份恢复，否则在线安装）
  ${BOLD}restore${NC}   从备份恢复 Rust（已安装时跳过，除非 --force）
  ${BOLD}backup${NC}    备份 Rust 工具链与配置
  ${BOLD}status${NC}    查看 Rust 安装状态、版本、备份数量
  ${BOLD}list${NC}      列出可用的备份文件
  ${BOLD}self-install${NC} 安装到 ~/.local/bin（别名: deploy）
  ${BOLD}help${NC}      显示此帮助

install 选项:
  --force, -f         强制重装（清理已安装的工具链，保留 cargo 配置）
  --no-restore        跳过本地备份恢复，直接在线安装
  --no-modify-path    不自动修改 shell 的 PATH（改为写入 . "\$HOME/.cargo/env"）

示例:
  $PROG_NAME status
  $PROG_NAME install
  $PROG_NAME install --force
  $PROG_NAME backup
  $PROG_NAME restore --force
  $PROG_NAME list

备份内容:
  ~/.rustup/                 工具链
  ~/.cargo/config.toml       cargo 配置
  ~/.cargo/credentials.toml  凭证
  ~/.cargo/env               环境脚本
  ~/.cargo/bin/              已安装的 cargo 子命令
  ${DIM}~/.cargo/registry/ 与 ~/.cargo/git/ 为缓存目录，不备份${NC}

环境变量:
  RUSTMGR_BACKUP_DIR   备份目录 (默认: ~/.local/share/rustmgr/backups)
  RUSTUP_HOME          rustup 目录 (默认: \$HOME/.rustup)
  CARGO_HOME           cargo 目录 (默认: \$HOME/.cargo)
  RUSTUP_INIT_URL      rustup 安装脚本 (默认: $RUSTUP_INIT_URL)
EOF
}

# ================================================================
# 主入口
# ================================================================
main() {
    local cmd="${1:-}"
    [ "$#" -gt 0 ] && shift

    case "$cmd" in
        install|i)           cmd_install  "$@" ;;
        backup|b)            cmd_backup   "$@" ;;
        restore|r|recover)   cmd_restore  "$@" ;;
        status|st|s)         cmd_status   "$@" ;;
        list|ls|l)           cmd_list     "$@" ;;
        self-install|deploy) cmd_self_install "$@" ;;
        help|-h|--help)      show_help ;;
        version|-v|--version) printf '%s %s\n' "$PROG_NAME" "$VERSION" ;;
        "")
            show_help
            return 1
            ;;
        *)
            log_error "未知命令: $cmd"
            show_help
            return 1
            ;;
    esac
}

main "$@"